# Copy to .env with `scripts/init-env.sh` (generates random secrets). Never commit .env.

# PostgreSQL superuser and per-service roles (created by infrastructure/docker/postgres/init.sh)
POSTGRES_PASSWORD=change-me
DAGSTER_PG_PASSWORD=change-me
COSTLAKE_PG_PASSWORD=change-me
GRAFANA_PG_PASSWORD=change-me

# Grafana admin (http://127.0.0.1:3001, user "admin")
GRAFANA_ADMIN_PASSWORD=change-me

# S3 identities of the local SeaweedFS object store
S3_ADMIN_ACCESS_KEY=change-me        # Terraform only (bucket administration)
S3_ADMIN_SECRET_KEY=change-me
S3_EXPORTER_ACCESS_KEY=change-me     # writes billing exports to the landing bucket
S3_EXPORTER_SECRET_KEY=change-me
S3_PIPELINE_ACCESS_KEY=change-me     # costlake runtime: read landing, read/write lake
S3_PIPELINE_SECRET_KEY=change-me

# Optional: image tag used by docker compose (default "local")
# COSTLAKE_IMAGE_TAG=local
